{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "react",
    "nextjs",
    "jsx-a11y",
    "typescript",
    "oxc"
  ],
  "categories": {
    "correctness": "deny",
    "suspicious": "warn",
    "perf": "warn"
  },
  "ignorePatterns": [
    ".next/**",
    "node_modules/**",
    "out/**",
    "build/**",
    "next-env.d.ts",
    "playwright-report/**",
    "test-results/**"
  ],
  "rules": {
    "react/react-in-jsx-scope": "off"
  }
}